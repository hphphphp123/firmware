--cpu Cortex-M3
"led-light-2\startup_stm32f103xb.o"
"led-light-2\main.o"
"led-light-2\stm32f1xx_it.o"
"led-light-2\stm32f1xx_hal_msp.o"
"led-light-2\stm32f1xx_hal_gpio_ex.o"
"led-light-2\stm32f1xx_hal.o"
"led-light-2\stm32f1xx_hal_rcc.o"
"led-light-2\stm32f1xx_hal_rcc_ex.o"
"led-light-2\stm32f1xx_hal_gpio.o"
"led-light-2\stm32f1xx_hal_dma.o"
"led-light-2\stm32f1xx_hal_cortex.o"
"led-light-2\stm32f1xx_hal_pwr.o"
"led-light-2\stm32f1xx_hal_flash.o"
"led-light-2\stm32f1xx_hal_flash_ex.o"
"led-light-2\stm32f1xx_hal_exti.o"
"led-light-2\system_stm32f1xx.o"
--strict --scatter "led-light-2\led-light-2.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "led-light-2.map" -o led-light-2\led-light-2.axf